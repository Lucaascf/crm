// Banco de dados do CRM de mudanças.
// SQLite não suporta enums nativamente no Prisma, por isso status e tipos
// são strings validadas em código (ver src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  clients      Client[]
  appointments Appointment[]
  tasks        Task[]
}

model Client {
  id     String @id @default(cuid())
  name   String
  whatsapp String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Mudança
  originAddress      String?
  destinationAddress String?
  movingDate         DateTime?
  propertyType       String?
  movingNotes        String?
  stairsOrElevator   String? // escada ou elevador, na origem e no destino
  truckAccess        String? // se o caminhão consegue parar na porta dos dois locais

  // Orçamento
  budgetValue Float?
  budgetNotes String?

  // Negociação
  status String @default("NOVO_CONTATO")

  // Bot do WhatsApp (ver whatsapp-bot/)
  whatsappChatId   String?   @unique // id bruto do whatsapp-web.js (...@c.us ou ...@lid), usado pra mandar mensagem
  awaitingBudget   Boolean   @default(false) // bot já coletou tudo, só falta o valor ser preenchido no site
  budgetSentAt     DateTime? // quando o bot mandou o orçamento pro cliente
  nameConfirmed    Boolean   @default(false) // true quando o próprio cliente confirmou o nome completo na conversa (não é só o nome salvo no WhatsApp)
  vistoriaResolved Boolean   @default(false) // true quando o bot já perguntou sobre vistoria e o cliente respondeu (presencial ou preferiu mandar fotos/vídeo)
  vistoriaType     String? // "presencial" | "fotos" — o que o cliente escolheu
  collectingVistoriaMedia Boolean @default(false) // true enquanto o bot espera o cliente terminar de mandar fotos/vídeos da vistoria

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historyEntries HistoryEntry[]
  appointments   Appointment[]
  tasks          Task[]
  messages       Message[]
  mediaFiles     MediaFile[]

  @@index([status])
  @@index([movingDate])
  @@index([userId])
}

model Message {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  direction   String // "IN" | "OUT"
  text        String
  waMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([clientId])
}

model MediaFile {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type     String // "image" | "video"
  mimeType String?
  filePath String // caminho público servido pelo app Next.js (ex: /uploads/clients/<id>/<arquivo>)
  caption  String? // legenda que o cliente mandou junto, se houver

  createdAt DateTime @default(now())

  @@index([clientId])
}

model HistoryEntry {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  text      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Appointment {
  id   String @id @default(cuid())
  title String
  type  String // VISTORIA | MUDANCA | RETORNO | FOLLOWUP

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime
  time  String?
  notes String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Confirmação de vistoria com o bot (ver whatsapp-bot/) — só usado quando type = VISTORIA
  confirmedByUser   Boolean   @default(false) // o usuário logado confirmou que esse dia/horário funciona
  proposalSentAt    DateTime? // quando o bot mandou a proposta desse horário pro cliente
  clientRespondedAt DateTime? // quando a resposta do cliente foi processada
  clientAccepted    Boolean? // null = sem resposta ainda, true = aceitou, false = pediu outro horário

  @@index([date])
  @@index([type])
  @@index([clientId])
  @@index([userId])
}

model Task {
  id    String @id @default(cuid())
  title String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime
  time  String?
  notes String?
  done  Boolean @default(false)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([done])
  @@index([clientId])
  @@index([userId])
}
